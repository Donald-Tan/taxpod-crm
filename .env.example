# Supabase (Project Settings -> API). The service role / secret key is used
# server-side only; it is never sent to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Run `npm run models` to see which model IDs your key can use.
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Optional: a separate (lighter) model for reranking. Each model has its own
# free-tier daily quota, so this roughly halves usage of the chat model.
# Leave empty to rerank with GEMINI_CHAT_MODEL.
GEMINI_RERANK_MODEL=

# RAG tuning (optional, these are the defaults)
RAG_CANDIDATES=20
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.45
